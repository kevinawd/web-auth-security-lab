# Puerto y host del backend (Stage 1)
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Ruta del archivo SQLite (relativa a server/)
DB_FILE=data/lab.sqlite

# Orígenes permitidos por CORS (frontend de desarrollo Vite)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Coste del hash bcrypt (10 es razonable para un laboratorio)
BCRYPT_ROUNDS=10
